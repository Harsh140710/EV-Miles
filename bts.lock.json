    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"dev\": \"bun run --hot src/index.ts\",\n    \"start\": \"bun run dist/index.js\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@ev-miles/env\": \"workspace:*\",\n    \"express\": \"^5.2.1\",\n    \"cors\": \"^2.8.6\",\n    \"nodemailer\": \"^9.0.5\",\n    \"socket.io\": \"^4.8.3\",\n    \"ioredis\": \"^5.11.1\",\n    \"cloudinary\": \"^2.10.1\",\n    \"@ev-miles/db\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"tsdown\": \"^0.22.3\",\n    \"@ev-miles/config\": \"workspace:*\",\n    \"@types/express\": \"^5.0.6\",\n    \"@types/cors\": \"^2.8.19\",\n    \"@types/bun\": \"catalog:\",\n    \"@types/nodemailer\": \"^8.0.1\"\n  }\n}\n",
