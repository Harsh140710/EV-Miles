    "package.json": "{\n  \"name\": \"ev-miles\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": {\n    \"packages\": [\n      \"apps/*\",\n      \"packages/*\"\n    ],\n    \"catalog\": {\n      \"dotenv\": \"^17.4.2\",\n      \"zod\": \"^4.4.3\",\n      \"@types/bun\": \"^1.4.0\",\n      \"@prisma/client\": \"^7.9.1\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"turbo dev\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"turbo -F server dev\",\n    \"db:push\": \"turbo -F @ev-miles/db db:push\",\n    \"db:studio\": \"turbo -F @ev-miles/db db:studio\",\n    \"db:generate\": \"turbo -F @ev-miles/db db:generate\",\n    \"db:migrate\": \"turbo -F @ev-miles/db db:migrate\"\n  },\n  \"packageManager\": \"bun@1.3.5\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@ev-miles/env\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@types/bun\": \"catalog:\",\n    \"@ev-miles/config\": \"workspace:*\",\n    \"vercel\": \"^54.18.2\",\n    \"turbo\": \"2.10.11\"\n  }\n}\n",
