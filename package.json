{
  "name": "ev-miles",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.4.0",
      "@prisma/client": "^7.9.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ev-miles/db db:push",
    "db:studio": "turbo -F @ev-miles/db db:studio",
    "db:generate": "turbo -F @ev-miles/db db:generate",
    "db:migrate": "turbo -F @ev-miles/db db:migrate"
  },
  "dependencies": {
    "@ev-miles/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ev-miles/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "2.10.11",
    "typescript": "^6.0.3",
    "vercel": "^54.18.2"
  },
  "packageManager": "bun@1.3.14"
}
